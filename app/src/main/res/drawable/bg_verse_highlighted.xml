<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
	<item>
		<shape android:shape="rectangle">
			<solid android:color="@color/colorVerseHighlightBg" />
			<stroke
				android:width="1dp"
				android:color="@color/colorVerseHighlightStroke" />
		</shape>
	</item>
	<item android:gravity="start">
		<shape android:shape="rectangle">
			<solid android:color="@color/colorVerseHighlightStroke" />
			<size android:width="5dp" />
		</shape>
	</item>
</layer-list>
