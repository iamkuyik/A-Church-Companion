<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:background="@drawable/bg_dialog_rounded"
	android:orientation="vertical"
	android:paddingHorizontal="20dp"
	android:paddingTop="22dp"
	android:paddingBottom="16dp">

	<!-- Editorial Dialog Header -->
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:fontFamily="@font/jetbrains_mono"
		android:letterSpacing="0.12"
		android:text="READING &amp; APPEARANCE"
		android:textColor="@color/colorAntiqueGold"
		android:textSize="10.5sp"
		android:textStyle="bold" />

	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="4dp"
		android:fontFamily="@font/crimson_pro"
		android:text="Typography &amp; Theme"
		android:textColor="@color/colorTextPrimary"
		android:textSize="20sp"
		android:textStyle="bold" />

	<!-- 1. Theme Selector (Light / Dark / Auto) -->
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="18dp"
		android:layout_marginBottom="6dp"
		android:fontFamily="@font/jetbrains_mono"
		android:letterSpacing="0.1"
		android:text="COLOR THEME"
		android:textColor="@color/colorTextTertiary"
		android:textSize="10.5sp"
		android:textStyle="bold" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="40dp"
		android:background="@drawable/bg_search_bar"
		android:orientation="horizontal"
		android:padding="3dp">

		<TextView
			android:id="@+id/tab_theme_light"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:clickable="true"
			android:focusable="true"
			android:fontFamily="@font/jetbrains_mono"
			android:gravity="center"
			android:letterSpacing="0.05"
			android:text="☀ LIGHT"
			android:textColor="@color/colorTextSecondary"
			android:textSize="11sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tab_theme_dark"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:clickable="true"
			android:focusable="true"
			android:fontFamily="@font/jetbrains_mono"
			android:gravity="center"
			android:letterSpacing="0.05"
			android:text="☾ DARK"
			android:textColor="@color/colorTextSecondary"
			android:textSize="11sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tab_theme_system"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:clickable="true"
			android:focusable="true"
			android:fontFamily="@font/jetbrains_mono"
			android:gravity="center"
			android:letterSpacing="0.05"
			android:text="AUTO"
			android:textColor="@color/colorTextSecondary"
			android:textSize="11sp"
			android:textStyle="bold" />
	</LinearLayout>

	<!-- 2. Font Family Selector -->
	<TextView
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="6dp"
		android:fontFamily="@font/jetbrains_mono"
		android:letterSpacing="0.1"
		android:text="READING FONT"
		android:textColor="@color/colorTextTertiary"
		android:textSize="10.5sp"
		android:textStyle="bold" />

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="42dp"
		android:background="@drawable/bg_search_bar"
		android:orientation="horizontal"
		android:padding="3dp">

		<TextView
			android:id="@+id/tab_font_system"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:clickable="true"
			android:focusable="true"
			android:gravity="center"
			android:text="System"
			android:textColor="@color/colorTextSecondary"
			android:textSize="12.5sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tab_font_editorial"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:clickable="true"
			android:focusable="true"
			android:fontFamily="@font/crimson_pro"
			android:gravity="center"
			android:text="Editorial"
			android:textColor="@color/colorAntiqueGold"
			android:textSize="13.5sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tab_font_serif"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:clickable="true"
			android:focusable="true"
			android:fontFamily="serif"
			android:gravity="center"
			android:text="Classic"
			android:textColor="@color/colorTextSecondary"
			android:textSize="12.5sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tab_font_sans"
			android:layout_width="0dp"
			android:layout_height="match_parent"
			android:layout_weight="1"
			android:clickable="true"
			android:focusable="true"
			android:fontFamily="sans-serif-medium"
			android:gravity="center"
			android:text="Sans"
			android:textColor="@color/colorTextSecondary"
			android:textSize="12.5sp"
			android:textStyle="bold" />
	</LinearLayout>

	<!-- 3. Type Size Slider -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="16dp"
		android:layout_marginBottom="4dp"
		android:gravity="center_vertical"
		android:orientation="horizontal">

		<TextView
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:fontFamily="@font/jetbrains_mono"
			android:letterSpacing="0.1"
			android:text="TYPE SIZE"
			android:textColor="@color/colorTextTertiary"
			android:textSize="10.5sp"
			android:textStyle="bold" />

		<TextView
			android:id="@+id/tv_size_value"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:background="@drawable/bg_version_pill"
			android:fontFamily="@font/jetbrains_mono"
			android:paddingHorizontal="8dp"
			android:paddingVertical="2dp"
			android:text="18 sp"
			android:textColor="@color/colorAntiqueGold"
			android:textSize="11sp"
			android:textStyle="bold" />
	</LinearLayout>

	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="44dp"
		android:background="@drawable/bg_search_bar"
		android:gravity="center_vertical"
		android:orientation="horizontal"
		android:paddingHorizontal="12dp">

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:fontFamily="serif"
			android:text="A"
			android:textColor="@color/colorTextSecondary"
			android:textSize="13sp"
			android:textStyle="bold" />

		<SeekBar
			android:id="@+id/seekbar_font_size"
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:contentDescription="Font size slider"
			android:max="20"
			android:progressTint="@color/colorAntiqueGold"
			android:thumbTint="@color/colorAntiqueGold" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:fontFamily="serif"
			android:text="A"
			android:textColor="@color/colorTextPrimary"
			android:textSize="19sp"
			android:textStyle="bold" />
	</LinearLayout>

	<!-- Bottom Close Button -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="12dp"
		android:gravity="end"
		android:orientation="horizontal">

		<com.google.android.material.button.MaterialButton
			android:id="@+id/btn_typography_done"
			style="@style/Widget.MaterialComponents.Button.TextButton"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:fontFamily="@font/jetbrains_mono"
			android:letterSpacing="0.08"
			android:text="DONE"
			android:textColor="@color/colorAntiqueGold"
			android:textSize="12sp" />
	</LinearLayout>
</LinearLayout>
