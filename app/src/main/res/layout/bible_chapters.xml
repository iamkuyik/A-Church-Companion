<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:orientation="vertical">

	<!-- Editorial Top Bar -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingStart="10dp"
		android:paddingEnd="20dp"
		android:paddingTop="14dp"
		android:paddingBottom="10dp">

		<ImageButton
			android:id="@+id/btn_back"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:src="@drawable/ic_arrow_back"
			android:contentDescription="Back"
			app:tint="@color/colorTextPrimary" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="6dp"
			android:orientation="vertical">

			<TextView
				android:id="@+id/header_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="@font/crimson_pro"
				android:text="Book Title"
				android:textColor="@color/colorTextPrimary"
				android:textSize="18sp"
				android:textStyle="bold" />

			<TextView
				android:id="@+id/header_subtitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="1dp"
				android:fontFamily="sans-serif"
				android:text="Select a Chapter • Ibuot"
				android:textColor="@color/colorTextSecondary"
				android:textSize="12sp" />
		</LinearLayout>
	</LinearLayout>

	<!-- Hairline Divider -->
	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/colorCardBorder" />

	<!-- Chapter Selection 5-Column Editorial Matrix (Full-Width Expanded Grid) -->
	<GridView
		android:id="@+id/gridview1"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:paddingStart="12dp"
		android:paddingEnd="12dp"
		android:paddingTop="16dp"
		android:paddingBottom="24dp"
		android:clipToPadding="false"
		android:numColumns="5"
		android:horizontalSpacing="12dp"
		android:verticalSpacing="12dp"
		android:gravity="center"
		android:scrollbars="vertical"
		android:stretchMode="columnWidth"
		tools:listitem="@layout/chapter_row" />
</LinearLayout>
