<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:id="@+id/verse_row_root"
	android:layout_width="match_parent"
	android:layout_height="wrap_content"
	android:orientation="vertical"
	android:background="?android:attr/selectableItemBackground"
	android:paddingHorizontal="20dp"
	android:paddingTop="18dp"
	android:paddingBottom="4dp">

	<!-- 5. Verse Number Badge with Gold Hairline, Highlighted Badge & Bookmark Indicator -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical">

		<TextView
			android:id="@+id/tv_verse_num"
			android:focusable="false"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:paddingHorizontal="9dp"
			android:paddingVertical="3dp"
			android:gravity="center"
			android:background="@drawable/bg_verse_pill"
			android:fontFamily="@font/jetbrains_mono"
			android:text="1"
			android:textColor="@color/colorAntiqueGold"
			android:textSize="12sp"
			android:textStyle="bold"
			android:letterSpacing="0.08" />

		<View
			android:layout_width="20dp"
			android:layout_height="1dp"
			android:layout_marginStart="8dp"
			android:background="@color/colorCardBorder" />

		<TextView
			android:id="@+id/tv_verse_highlight_badge"
			android:focusable="false"
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginStart="8dp"
			android:paddingHorizontal="8dp"
			android:paddingVertical="2dp"
			android:background="@drawable/bg_badge_gold"
			android:fontFamily="@font/jetbrains_mono"
			android:text="★ BOOKMARKED"
			android:textColor="@color/colorAntiqueGold"
			android:textSize="9.5sp"
			android:textStyle="bold"
			android:letterSpacing="0.08"
			android:visibility="gone" />

		<View
			android:layout_width="0dp"
			android:layout_height="1dp"
			android:layout_weight="1" />

		<ImageView
			android:id="@+id/iv_verse_bookmark"
			android:layout_width="16dp"
			android:layout_height="16dp"
			android:src="@drawable/ic_bookmark_filled"
			app:tint="@color/colorAntiqueGold"
			android:contentDescription="Bookmarked Verse"
			android:visibility="gone" />
	</LinearLayout>

	<!-- Primary Scripture Passage (English in Parallel, or whichever active translation in Single) -->
	<TextView
		android:id="@+id/tv_primary"
		android:focusable="false"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="8dp"
		android:includeFontPadding="false"
		android:fontFamily="@font/crimson_pro"
		android:text="In the beginning God created the heaven and the earth."
		android:textColor="@color/colorTextPrimary"
		android:textSize="17.5sp"
		android:lineSpacingMultiplier="1.45" />

	<!-- Secondary Scripture Passage (Efik in Parallel, with Accent Left Border) -->
	<TextView
		android:id="@+id/tv_secondary"
		android:focusable="false"
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:layout_marginTop="10dp"
		android:includeFontPadding="false"
		android:background="@drawable/bg_english_verse_border"
		android:paddingStart="12dp"
		android:paddingEnd="4dp"
		android:fontFamily="@font/crimson_pro"
		android:textStyle="italic"
		android:text="Ke editọñọ Abasi okobot enyọñ ye isọñ."
		android:textColor="@color/colorEnglishScripture"
		android:textSize="15.5sp"
		android:lineSpacingMultiplier="1.4" />

	<!-- Fine Hairline Divider between verses -->
	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:layout_marginTop="18dp"
		android:background="@color/colorCardBorder" />
</LinearLayout>
