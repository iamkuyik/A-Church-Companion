<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
	xmlns:android="http://schemas.android.com/apk/res/android"
	xmlns:app="http://schemas.android.com/apk/res-auto"
	xmlns:tools="http://schemas.android.com/tools"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:background="@color/colorBackground"
	android:orientation="vertical">

	<!-- Editorial Top Bar -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:orientation="horizontal"
		android:gravity="center_vertical"
		android:paddingStart="10dp"
		android:paddingEnd="20dp"
		android:paddingTop="14dp"
		android:paddingBottom="10dp">

		<ImageButton
			android:id="@+id/btn_back"
			android:layout_width="48dp"
			android:layout_height="48dp"
			android:background="?android:attr/selectableItemBackgroundBorderless"
			android:src="@drawable/ic_arrow_back"
			android:contentDescription="Back"
			app:tint="@color/colorTextPrimary" />

		<LinearLayout
			android:layout_width="0dp"
			android:layout_height="wrap_content"
			android:layout_weight="1"
			android:layout_marginStart="6dp"
			android:orientation="vertical">

			<TextView
				android:id="@+id/header_title"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:fontFamily="@font/crimson_pro"
				android:text="Songs of the Church"
				android:textColor="@color/colorTextPrimary"
				android:textSize="18sp"
				android:textStyle="bold" />

			<TextView
				android:id="@+id/header_subtitle"
				android:layout_width="wrap_content"
				android:layout_height="wrap_content"
				android:layout_marginTop="1dp"
				android:fontFamily="sans-serif"
				android:text="Standard English Hymnal"
				android:textColor="@color/colorTextSecondary"
				android:textSize="12sp" />
		</LinearLayout>
	</LinearLayout>

	<!-- Hairline Divider -->
	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/colorCardBorder" />

	<!-- Search Bar Container -->
	<LinearLayout
		android:layout_width="match_parent"
		android:layout_height="wrap_content"
		android:paddingHorizontal="20dp"
		android:paddingTop="12dp"
		android:paddingBottom="10dp">

		<LinearLayout
			android:layout_width="match_parent"
			android:layout_height="44dp"
			android:background="@drawable/bg_search_bar"
			android:gravity="center_vertical"
			android:orientation="horizontal"
			android:paddingStart="14dp"
			android:paddingEnd="8dp">

			<ImageView
				android:layout_width="18dp"
				android:layout_height="18dp"
				android:src="@drawable/ic_search"
				app:tint="@color/colorTextTertiary"
				android:layout_marginEnd="10dp"
				android:importantForAccessibility="no" />

			<EditText
				android:id="@+id/et_search"
				android:layout_width="0dp"
				android:layout_height="match_parent"
				android:layout_weight="1"
				android:background="@null"
				android:fontFamily="sans-serif"
				android:hint="Search by title, number, or lyrics…"
				android:textColor="@color/colorTextPrimary"
				android:textColorHint="@color/colorTextTertiary"
				android:textSize="14sp"
				android:singleLine="true"
				android:imeOptions="actionSearch" />

			<TextView
				android:id="@+id/btn_clear_search"
				android:layout_width="32dp"
				android:layout_height="32dp"
				android:layout_marginEnd="4dp"
				android:background="?android:attr/selectableItemBackgroundBorderless"
				android:clickable="true"
				android:focusable="true"
				android:contentDescription="Clear search"
				android:gravity="center"
				android:text="✕"
				android:textColor="@color/colorTextTertiary"
				android:textSize="14sp"
				android:textStyle="bold"
				android:visibility="gone" />

			<TextView
				android:id="@+id/btn_keypad_mode"
				android:layout_width="wrap_content"
				android:layout_height="match_parent"
				android:gravity="center"
				android:paddingHorizontal="6dp"
				android:fontFamily="sans-serif-medium"
				android:contentDescription="Toggle numeric or text keyboard"
				android:text="123"
				android:textColor="@color/colorAntiqueGold"
				android:textSize="13sp"
				android:letterSpacing="0.06"
				android:background="?android:attr/selectableItemBackgroundBorderless" />
		</LinearLayout>
	</LinearLayout>

	<!-- Hairline Divider -->
	<View
		android:layout_width="match_parent"
		android:layout_height="1dp"
		android:background="@color/colorCardBorder" />

	<!-- Empty Search State -->
	<LinearLayout
		android:id="@+id/layout_empty"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:gravity="center"
		android:orientation="vertical"
		android:padding="32dp"
		android:visibility="gone">

		<ImageView
			android:layout_width="42dp"
			android:layout_height="42dp"
			android:src="@drawable/ic_search"
			app:tint="@color/colorTextTertiary"
			android:layout_marginBottom="14dp"
			android:importantForAccessibility="no" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:fontFamily="@font/crimson_pro"
			android:text="No Hymns Found"
			android:textColor="@color/colorTextPrimary"
			android:textSize="18sp"
			android:textStyle="bold" />

		<TextView
			android:layout_width="wrap_content"
			android:layout_height="wrap_content"
			android:layout_marginTop="6dp"
			android:fontFamily="sans-serif"
			android:gravity="center"
			android:text="No hymns matched your search query."
			android:textColor="@color/colorTextSecondary"
			android:textSize="13sp" />

		<TextView
			android:id="@+id/btn_clear_empty"
			android:layout_width="wrap_content"
			android:layout_height="38dp"
			android:layout_marginTop="16dp"
			android:background="@drawable/bg_badge_gold"
			android:clickable="true"
			android:focusable="true"
			android:fontFamily="@font/jetbrains_mono"
			android:foreground="?android:attr/selectableItemBackground"
			android:gravity="center"
			android:letterSpacing="0.08"
			android:paddingHorizontal="18dp"
			android:text="CLEAR SEARCH"
			android:textColor="@color/colorAntiqueGold"
			android:textSize="11.5sp"
			android:textStyle="bold" />
	</LinearLayout>

	<!-- Hymn List -->
	<ListView
		android:id="@+id/listview1"
		android:layout_width="match_parent"
		android:layout_height="0dp"
		android:layout_weight="1"
		android:clipToPadding="false"
		android:divider="@null"
		android:dividerHeight="0dp"
		android:paddingBottom="24dp"
		android:scrollbars="vertical"
		android:fastScrollEnabled="true"
		android:choiceMode="none"
		tools:listitem="@layout/efik_hymn_row" />
</LinearLayout>
